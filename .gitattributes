# Store text files with LF in the repository; Git converts them on checkout.
* text=auto

# Unix scripts must keep LF, otherwise ./mvnw fails on Linux and macOS.
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jar binary
